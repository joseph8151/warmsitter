# ------------------------------------------------------------------
# warm sitter — environment variables
# ------------------------------------------------------------------

# Database (PostgreSQL).
#
# DATABASE_URL  -> pooled connection used at runtime (serverless-safe).
# DIRECT_URL    -> direct/unpooled connection used for `prisma migrate`.
#
# Neon:     DATABASE_URL = the "-pooler" host; DIRECT_URL = the non-pooler host.
# Supabase: DATABASE_URL = port 6543 (pgBouncer, ?pgbouncer=true);
#           DIRECT_URL = port 5432.
# Local/single instance: set DIRECT_URL equal to DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warmsitter?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/warmsitter?schema=public"

# ------------------------------------------------------------------
# Toss Payments (https://docs.tosspayments.com)
# ------------------------------------------------------------------
# Client key is exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxxxxxxxxxxx"
# Secret key is server-only. Used for the payment confirm/settlement API.
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret from the Toss developer console.
TOSS_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# Base URL used to build success/fail redirect URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Supabase — Auth + Storage (https://supabase.com)
# ------------------------------------------------------------------
# Project URL + anon (public) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key is SERVER-ONLY. Used for privileged Storage uploads.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket names (create them in the Supabase dashboard, public read).
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_WORKLOGS_BUCKET="worklogs"
# Private bucket for identity documents (신원확인). Do NOT make this public.
SUPABASE_VERIFICATIONS_BUCKET="verifications"

# When Supabase vars above are empty, the app falls back to the demo auth stub
# (ws_uid cookie) so it still runs locally without Supabase configured.

# Dev-only: user id used by the demo auth stub (see src/lib/auth.ts).
DEV_USER_ID=""

# Secret protecting the daily expiry cron (/api/cron/expiry).
# On Vercel, set this env var and Vercel Cron automatically sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
